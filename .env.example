PROJECT_NAME="Face Attendance AI"
API_V1_STR="/api/v1"
ENVIRONMENT=development
DEBUG=false

# Security
SECRET_KEY="tao_mot_chuoi_that_dai_va_bao_mat_o_day"
CSRF_SECRET_KEY="another-random-secret-for-csrf-protection"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,testserver,backend
MAX_REQUEST_BODY_SIZE=5242880

# Rate Limiting
RATE_LIMIT_LOGIN=300/minute
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
RATE_LIMIT_REGISTER=3/minute
RATE_LIMIT_REFRESH=10/minute

# MySQL Database
# docker-compose: MYSQL_PASSWORD is the root password (mysql container, backups only);
# the backend connects as MYSQL_APP_USER, created/updated by the mysql-init service.
# Managed MySQL (no compose): MYSQL_USER/MYSQL_PASSWORD are the backend credentials.
MYSQL_USER=root
MYSQL_PASSWORD=secret
MYSQL_APP_USER=eduface_app
MYSQL_APP_PASSWORD=change-me-generate-with-secrets-token_urlsafe
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=face_attendance_db
# Set these for managed MySQL providers such as Aiven. Do not commit the CA file.
MYSQL_SSL_REQUIRED=false
MYSQL_SSL_CA=
MYSQL_SSL_CA_BASE64=

# Redis (docker-compose builds REDIS_URL from REDIS_PASSWORD)
REDIS_PASSWORD=change-me-generate-with-secrets-token_urlsafe
REDIS_URL=redis://:change-me-generate-with-secrets-token_urlsafe@localhost:6379/0
# Pool is per backend worker: (DB_POOL_SIZE + DB_MAX_OVERFLOW) x BACKEND_WORKERS < MYSQL_MAX_CONNECTIONS
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=15
DB_POOL_TIMEOUT=10
DB_CONNECT_TIMEOUT=10
REPORT_MAX_ROWS=10000

# Anti-spoofing: MiniFASNet ensemble (Silent-Face-Anti-Spoofing, Apache-2.0).
# Build the .onnx files once with: sh scripts/liveness/build_models.sh
LIVENESS_MODELS=/models/minifasnet_v2_2.7.onnx@2.7,/models/minifasnet_v1se_4.0.onnx@4.0
LIVENESS_INPUT_WIDTH=80
LIVENESS_INPUT_HEIGHT=80
LIVENESS_INPUT_LAYOUT=NCHW
LIVENESS_COLOR_SPACE=BGR
LIVENESS_NORMALIZATION=none
LIVENESS_OUTPUT_TYPE=logits
LIVENESS_LIVE_CLASS_INDEX=1
LIVENESS_THRESHOLD=0.80

# Scaling (docker-compose)
BACKEND_WORKERS=4
MYSQL_MAX_CONNECTIONS=200
# AI_WORKERS x ONNX_INTRA_OP_THREADS <= CPU cores; each AI worker needs ~1GB RAM.
AI_WORKERS=3
ONNX_INTRA_OP_THREADS=2

# Face rate limits
RATE_LIMIT_FACE_RECOGNIZE=90/minute
RATE_LIMIT_FACE_DETECT=90/minute
RATE_LIMIT_FACE_ENROLL=10/hour

# Biometric data protection
# AES-256-GCM key (Base64, 32 bytes): python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
# BACK IT UP together with the database backups: without it face profiles are unreadable.
FACE_EMBEDDING_KEY=
BIOMETRIC_POLICY_VERSION=2026-10
EVIDENCE_RETENTION_DAYS=180
# Campus time zone as minutes from UTC (Vietnam = 420). Timetables are entered in this local time.
APP_UTC_OFFSET_MINUTES=420
BACKUP_RETENTION_DAYS=14

# Self-hosted HTTPS (docker-compose.prod.yml + Caddy / Let's Encrypt)
DOMAIN=
ACME_EMAIL=
