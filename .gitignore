# ==========================================
# BIẾN MÔI TRƯỜNG & SECRETS
# ==========================================
.env
.env.*
backend/certs/*.pem
!backend/certs/.gitkeep
.env.local
.env.*.local
*.pem
*.key
# Database exports can contain all production and attendance data.
/face_attendance_backup.sql
/*-backup.sql

# ==========================================
# BACKEND (PYTHON / FASTAPI)
# ==========================================
# Môi trường ảo (Virtual Environments)
venv/
env/
backend/venv/

# Byte-compiled / Optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C libraries
*.so

# PyTest & Coverage
.pytest_cache/
pytest-cache-files-*/
**/pytest-cache-files-*/
htmlcov/
.coverage
.coverage.*
.tox/

# SQLite databases (nếu test cục bộ)
*.sqlite3
*.db

# ==========================================
# FRONTEND (REACT / NODE.JS)
# ==========================================
node_modules/
frontend/node_modules/
dist/
build/
.npm/
npm-debug.log
yarn-error.log
yarn-debug.log
*.log

# ==========================================
# THƯ MỤC UPLOAD/MEDIA
# ==========================================
